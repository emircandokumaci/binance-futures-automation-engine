APP_ENV=production
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
TZ=Europe/Istanbul

POSTGRES_DB=jarvis_futures
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://jarvis:change-me-before-use@postgres:5432/jarvis_futures

BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_WS_BASE=wss://fstream.binance.com/market
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000
PRIVATE_RECONCILE_INTERVAL_SECONDS=15

NO_NEW_TRADES_START=08:00
NO_NEW_TRADES_END=09:00

DEFAULT_RISK_PCT=1.0
MAX_RISK_PCT=2.0
CONFIDENCE_RISK_SCALING_ENABLED=false
CONFIDENCE_LEVERAGE_SCALING_ENABLED=false
NORMAL_MAX_LEVERAGE=5
ABSOLUTE_MAX_LEVERAGE=10
MAX_PORTFOLIO_GROSS_LEVERAGE=3.0
MAX_MARGIN_UTILIZATION=0.50
DAILY_LOSS_LIMIT_PCT=10.0
HARD_DRAWDOWN_PCT=25.0
MAX_CONCURRENT_POSITIONS=2

PAPER_TAKER_FEE_RATE=0.0005
PAPER_SLIPPAGE_BPS=5.0
PAPER_STARTING_EQUITY=100.0

UNIVERSE_TOP_N=20
MIN_QUOTE_VOLUME_USDT=50000000
MAX_SPREAD_BPS=8.0
MIN_LISTING_AGE_DAYS=30

SHADOW_OUTCOME_HORIZON_HOURS=24
REQUIRE_LIQUIDATION_BRACKETS_FOR_LIVE=true
MIN_LIQUIDATION_BUFFER_PCT=7.5
MIN_LIQUIDATION_STOP_MULTIPLE=2.5
DYNAMIC_SLIPPAGE_FLOOR_BPS=0.5
DYNAMIC_SLIPPAGE_CAP_BPS=25.0
